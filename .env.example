# Copy to .env (setup.ps1 does this). NEVER commit .env. No real secrets belong in this example.
ADMIN_USERNAME=admin
# Leave empty to get a random password printed once on first start.
ADMIN_PASSWORD=
SESSION_HOURS=8
# Set true only when served over HTTPS
COOKIE_SECURE=false
# Optional overrides (relative paths are resolved against the project folder)
# CAMPUS_DATA_DIR=data
# CAMPUS_MODELS_DIR=models
# CAMPUS_REFERENCE_DIR=reference_images

# Local single-user mode (default): no sign-in screen, the app opens straight on the dashboard.
# Set to true to require username/password again (do this before exposing the app on a network).
CAMPUS_REQUIRE_LOGIN=false
